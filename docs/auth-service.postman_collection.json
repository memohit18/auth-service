{
  "info": {
    "name": "Auth Service",
    "description": "Auth service API — signup through login, tokens, Google OAuth, profile.\n\nImport this collection into Postman or Insomnia.\n\nSet collection variables:\n- baseUrl (default http://localhost:3302)\n- accessToken / refreshToken (auto-set after login, google, refresh)\n- verificationToken (from verification email after signup)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3302" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "verificationToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness check. No auth required."
          }
        }
      ]
    },
    {
      "name": "Auth — Signup & Verify",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mohit Kumar\",\n  \"email\": \"mohit@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup",
            "description": "Register with email/password.\n\nRequires env: DATABASE_URL, RESEND_API_KEY\n\nSends verification email. Response excludes password and verification token."
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-email",
            "description": "Confirm email with UUID token from verification email.\n\nRequires env: DATABASE_URL"
          }
        }
      ]
    },
    {
      "name": "Auth — Login",
      "item": [
        {
          "name": "Login (Web)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mohit@example.com\",\n  \"password\": \"password123\",\n  \"deviceType\": \"web\",\n  \"deviceName\": \"Chrome\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Email/password login.\n\nRequires: verified email, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, DATABASE_URL\n\nOptional: deviceType (web|mobile), deviceName"
          }
        },
        {
          "name": "Login (Mobile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mohit@example.com\",\n  \"password\": \"password123\",\n  \"deviceType\": \"mobile\",\n  \"deviceName\": \"iPhone 15\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Google Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"PASTE_GOOGLE_ID_TOKEN_HERE\",\n  \"deviceType\": \"web\",\n  \"deviceName\": \"Chrome\"\n}"
            },
            "url": "{{baseUrl}}/auth/google",
            "description": "Google Sign-In with idToken (NOT access token).\n\nRequires env: GOOGLE_CLIENT_ID, JWT secrets, DATABASE_URL"
          }
        }
      ]
    },
    {
      "name": "Auth — Tokens",
      "item": [
        {
          "name": "Refresh Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Rotate tokens. Old refresh token becomes invalid."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout",
            "description": "Revoke refresh token and linked session."
          }
        }
      ]
    },
    {
      "name": "Auth — Profile (JWT required)",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Get logged-in user profile.\n\nRequires: JWT_ACCESS_SECRET\n\nHeader: Authorization Bearer accessToken"
          }
        },
        {
          "name": "Update Current User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mohit Kumar\",\n  \"phone\": \"9876543210\",\n  \"countryCode\": \"+91\",\n  \"avatar\": \"https://example.com/avatar.png\"\n}"
            },
            "url": "{{baseUrl}}/auth/me",
            "description": "Update profile fields (all optional).\n\nUpdatable: name, phone, countryCode, avatar\n\nNot updatable via this endpoint: email, password, role, provider\n\nRequires: JWT_ACCESS_SECRET + Bearer accessToken"
          }
        }
      ]
    }
  ]
}
